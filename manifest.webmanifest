{
  "name": "איפה הכסף",
  "short_name": "איפה הכסף",
  "lang": "he",
  "dir": "rtl",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#FBF4E8",
  "theme_color": "#FBF4E8",
  "icons": [
    {"src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"}
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {"name": "chat", "accept": ["text/plain", ".txt", "application/zip", "application/x-zip-compressed", ".zip"]}
      ]
    }
  }
}
